package __PACKAGE__.overlay

import android.content.Context
import android.database.sqlite.SQLiteDatabase
import android.util.Log
import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.TimeZone
import kotlin.math.max
import kotlin.math.min

// Acceso directo a la misma base SQLite que usa expo-sqlite del lado de
// React Native (context.filesDir + "/SQLite/pandiario.db" -ver
// expo-sqlite/android SQLiteModule.kt, constante "defaultDatabaseDirectory"-).
// Esto permite que el panel flotante nativo (fuera del proceso de RN, sin
// abrir la app en primer plano) lea y escriba listas/gastos/wallet
// directamente; la próxima vez que la app se abra, DataContext vuelve a
// leer esta misma base y recoge los cambios sin necesitar sincronización
// especial. Todas las operaciones son de solo-mejor-esfuerzo: cualquier
// excepción se traga (nunca debe tumbar un Service en primer plano) y
// devuelve un resultado nulo/false que la UI del overlay interpreta como
// "no se pudo, vuelve a intentar".
//
// Toda escritura sigue el mismo patrón: transacción explícita
// (beginTransaction/setTransactionSuccessful/endTransaction) -> si
// confirmó, PRAGMA wal_checkpoint(PASSIVE) mientras la conexión sigue
// abierta (una vez comprometida la transacción, una nueva lectura desde
// la conexión de React Native ya ve los cambios sin necesitar ningún
// checkpoint -así funciona WAL entre conexiones distintas-; el
// checkpoint aquí es solo mantenimiento: vacía oportunistamente el WAL
// al archivo principal sin bloquear a nadie. Fue FULL hasta que se
// detectó que ese modo SÍ bloquea y puede hacer fallar con "database is
// locked" a un lector concurrente -ver el fix de ensureBootstrap en
// DataContext.tsx-) -> recién ahí se cierra la conexión y se emite
// NativeSync.emitDatabaseSyncRequired(). Este orden importa: emitir
// antes de que la transacción confirme podría hacer que DataContext
// refresque y todavía no vea la escritura.
//
// Cada conexión también fija PRAGMA busy_timeout al abrirse (ver
// open()): si esta conexión y la de React Native se tocan en el mismo
// instante, SQLite reintenta en silencio en vez de lanzar un error de
// inmediato.
object PanDb {
  data class ListRow(val id: String, val listCode: String, val title: String, val status: String)
  data class EntryRow(val id: String, val text: String, val done: Boolean, val extra: Boolean)

  private fun dbFile(context: Context): File = File(context.filesDir, "SQLite/pandiario.db")

  fun isAvailable(context: Context): Boolean = dbFile(context).exists()

  // Diagnóstico: confirma en logcat (adb logcat | grep PANDIARIO_DB) que
  // esta ruta absoluta coincide exactamente con la que loguea localDb.ts
  // del lado de React Native (db.databasePath) -ambas fórmulas de ruta
  // (context.filesDir + "/SQLite/pandiario.db") son idénticas por diseño,
  // pero esto lo confirma en un dispositivo real en vez de asumirlo-.
  // Solo se loguea una vez (no en cada open()) para no saturar logcat con
  // cada escritura nativa.
  @Volatile
  private var loggedPath = false
  private fun logPathOnce(context: Context) {
    if (loggedPath) return
    loggedPath = true
    try {
      Log.d("PANDIARIO_DB", "PanDb path: ${dbFile(context).absolutePath} (canonical: ${dbFile(context).canonicalPath})")
    } catch (_: Exception) {
    }
  }

  // busy_timeout: si esta conexión encuentra la base bloqueada por la
  // conexión de React Native (o viceversa), SQLite reintenta en silencio
  // hasta 3s en vez de lanzar "database is locked" de inmediato. Sin
  // esto, dos conexiones separadas tocando el mismo archivo -este
  // Service y expo-sqlite del lado de RN- pueden pisarse en el instante
  // exacto en que ambas leen/escriben a la vez.
  private fun open(context: Context): SQLiteDatabase? {
    return try {
      val file = dbFile(context)
      if (!file.exists()) return null
      logPathOnce(context)
      val db = SQLiteDatabase.openDatabase(file.absolutePath, null, SQLiteDatabase.OPEN_READWRITE)
      try {
        db.rawQuery("PRAGMA busy_timeout = 3000;", null)?.close()
      } catch (_: Exception) {
      }
      db
    } catch (_: Exception) {
      null
    }
  }

  private fun isoNow(): String {
    val sdf = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US)
    sdf.timeZone = TimeZone.getTimeZone("UTC")
    return sdf.format(Date())
  }

  private fun newId(prefix: String): String = "${prefix}_${System.currentTimeMillis()}_${(Math.random() * 10000).toInt()}"

  // Empuja el WAL hacia el archivo principal -ver comentario de
  // cabecera-. Debe llamarse con `db` todavía abierto, después de que la
  // transacción ya confirmó (endTransaction), y solo si la escritura
  // realmente tuvo éxito.
  //
  // PASSIVE, no FULL: un checkpoint FULL exige un lock exclusivo y
  // BLOQUEA hasta que todo lector activo termine -si en ese instante la
  // app de React Native está leyendo desde su propia conexión (ej. el
  // usuario abre la app justo cuando la burbuja termina de guardar), esa
  // lectura puede fallar con "database is locked" (SQLITE_BUSY). Como
  // ensureBootstrap() trataba cualquier error de lectura como "la cuenta
  // no tiene wallet todavía" (ver el fix en DataContext.tsx), ese
  // SQLITE_BUSY transitorio hacía que la app pareciera una instalación
  // recién hecha -balance en cero- hasta el próximo refresh exitoso.
  // PASSIVE hace lo mismo (vaciar tantos frames del WAL como pueda) pero
  // nunca bloquea ni le quita el lock a un lector u otro escritor activo:
  // si hay contención, simplemente checkpointea menos esta vez y ya, sin
  // arriesgar ese error.
  private fun checkpointWal(db: SQLiteDatabase) {
    try {
      db.rawQuery("PRAGMA wal_checkpoint(PASSIVE);", null)?.close()
    } catch (_: Exception) {
    }
  }

  fun getInProgressList(context: Context): ListRow? {
    val db = open(context) ?: return null
    try {
      db.rawQuery("SELECT id, list_code, title, status FROM lists WHERE status = 'in_progress' ORDER BY created_at DESC LIMIT 1", null).use { c ->
        if (c.moveToFirst()) return ListRow(c.getString(0), c.getString(1) ?: "", c.getString(2), c.getString(3))
      }
      return null
    } catch (_: Exception) {
      return null
    } finally {
      db.close()
    }
  }

  fun getList(context: Context, listId: String): ListRow? {
    val db = open(context) ?: return null
    try {
      db.rawQuery("SELECT id, list_code, title, status FROM lists WHERE id = ?", arrayOf(listId)).use { c ->
        if (c.moveToFirst()) return ListRow(c.getString(0), c.getString(1) ?: "", c.getString(2), c.getString(3))
      }
      return null
    } catch (_: Exception) {
      return null
    } finally {
      db.close()
    }
  }

  // Más recientes primero (mismo criterio que addListEntry en
  // src/context/DataContext.tsx): un ítem agregado durante la ejecución
  // aparece de inmediato arriba, empujando los anteriores hacia abajo.
  fun getEntries(context: Context, listId: String): List<EntryRow> {
    val db = open(context) ?: return emptyList()
    val out = mutableListOf<EntryRow>()
    try {
      db.rawQuery("SELECT id, text, done, extra FROM list_entries WHERE list_id = ? ORDER BY created_at DESC", arrayOf(listId)).use { c ->
        while (c.moveToNext()) {
          out.add(EntryRow(c.getString(0), c.getString(1), c.getInt(2) != 0, c.getInt(3) != 0))
        }
      }
    } catch (_: Exception) {
    } finally {
      db.close()
    }
    return out
  }

  fun toggleEntryDone(context: Context, entryId: String, done: Boolean) {
    val db = open(context) ?: return
    var ok = false
    try {
      db.beginTransaction()
      db.execSQL("UPDATE list_entries SET done = ? WHERE id = ?", arrayOf(if (done) 1 else 0, entryId))
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
  }

  // Todo ítem agregado desde el panel flotante mientras la lista está en
  // ejecución cuenta como "extra" (se ve en naranja en la app, igual que
  // los agregados desde el modo Editar del modal en-app).
  fun addEntry(context: Context, listId: String, text: String): Boolean {
    val db = open(context) ?: return false
    var ok = false
    try {
      db.beginTransaction()
      db.execSQL(
        "INSERT INTO list_entries (id, list_id, text, done, extra, created_at) VALUES (?, ?, ?, 0, 1, ?)",
        arrayOf(newId("entry"), listId, text, isoNow())
      )
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
    return ok
  }

  // Bloqueo estructural: solo se permite borrar ítems 'extra'. Los ítems
  // base (agregados antes de presionar Play) nunca se pueden quitar ni
  // renombrar desde aquí -la condición "extra = 1" en el WHERE hace que el
  // intento sea un no-op silencioso sobre un ítem base, no un error-.
  fun deleteExtraEntry(context: Context, entryId: String): Boolean {
    val db = open(context) ?: return false
    var deleted = false
    try {
      db.beginTransaction()
      deleted = db.delete("list_entries", "id = ? AND extra = 1", arrayOf(entryId)) > 0
      db.setTransactionSuccessful()
    } catch (_: Exception) {
      deleted = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (deleted) checkpointWal(db)
      db.close()
    }
    if (deleted) NativeSync.emitDatabaseSyncRequired(context)
    return deleted
  }

  fun getOpenCycleId(context: Context): String? {
    val db = open(context) ?: return null
    try {
      db.rawQuery("SELECT id FROM cycles WHERE end_date IS NULL ORDER BY start_date DESC LIMIT 1", null).use { c ->
        if (c.moveToFirst()) return c.getString(0)
      }
      return null
    } catch (_: Exception) {
      return null
    } finally {
      db.close()
    }
  }

  // Aplica el efecto de una transacción sobre Cartera/Caja Chica/Ahorro
  // (con soporte Mixto) y sobre el cupo de Presupuesto si el origen es
  // 'vital'/'secundario' -replica exactamente applyTxEffect de
  // src/context/DataContext.tsx-. Compartido por finalizePurchase,
  // addIncome y addExpense para no repetir esta lógica en cada punto de
  // escritura nativo. Debe llamarse dentro de una transacción ya abierta
  // por el caller (db.beginTransaction()/setTransactionSuccessful()).
  //
  // categoryId es el id real devuelto por ensureCategory (el caller
  // siempre lo resuelve antes de llamar aquí): se usa como emparejamiento
  // primario en vez de "type + name" -si el usuario renombra la categoría
  // después, el nombre de texto de una transacción vieja deja de
  // coincidir, pero el id sigue apuntando a la fila real-. category solo
  // queda como respaldo por si categoryId llega null (no debería pasar en
  // la práctica, pero evita perder el cupo si algún caller futuro lo
  // omite).
  private fun applyWalletEffect(db: SQLiteDatabase, kind: String, amount: Double, method: String, cashAmount: Double?, origin: String, category: String, categoryId: String?) {
    db.rawQuery("SELECT cartera_efectivo, cartera_digital, caja_chica, ahorro FROM wallet WHERE id = 'main'", null).use { c ->
      if (c.moveToFirst()) {
        var carteraEfectivo = c.getDouble(0)
        var carteraDigital = c.getDouble(1)
        var cajaChica = c.getDouble(2)
        var ahorro = c.getDouble(3)
        val sign = if (kind == "ingreso") 1.0 else -1.0
        val delta = sign * amount

        when {
          origin == "caja_chica" -> cajaChica += delta
          origin == "ahorro" -> ahorro += delta
          method == "mixto" -> {
            val cash = min(max(cashAmount ?: 0.0, 0.0), amount)
            val digital = amount - cash
            carteraEfectivo += sign * cash
            carteraDigital += sign * digital
          }
          method == "efectivo" -> carteraEfectivo += delta
          else -> carteraDigital += delta
        }

        db.execSQL(
          "UPDATE wallet SET cartera_efectivo = ?, cartera_digital = ?, caja_chica = ?, ahorro = ? WHERE id = 'main'",
          arrayOf(carteraEfectivo, carteraDigital, cajaChica, ahorro)
        )

        // Los ingresos siempre usan origin='cuenta' (ver addIncome), así
        // que esta rama solo se ejercita para gastos con cupo asignado.
        if (origin == "vital" || origin == "secundario") {
          val query = if (categoryId != null) {
            db.rawQuery("SELECT id, amount FROM budget_categories WHERE id = ?", arrayOf(categoryId))
          } else {
            db.rawQuery("SELECT id, amount FROM budget_categories WHERE type = ? AND name = ?", arrayOf(origin, category))
          }
          query.use { c2 ->
            if (c2.moveToFirst()) {
              val catId = c2.getString(0)
              val nextAmount = c2.getDouble(1) + delta
              db.execSQL("UPDATE budget_categories SET amount = ? WHERE id = ?", arrayOf(nextAmount, catId))
            }
          }
        }
      }
    }
  }

  // Busca la categoría por type+name y devuelve su id; si no existe todavía
  // -mismo auto-alta que "+ Añadir categoría" en Ingreso/Gasto/Presupuesto
  // de la app- la crea con cupo 0 y devuelve el id nuevo. Este id es lo que
  // se guarda en transactions.category_id, así que applyWalletEffect puede
  // encontrar la categoría real más tarde aunque el usuario la renombre.
  private fun ensureCategory(db: SQLiteDatabase, type: String, name: String): String? {
    if (name.isBlank()) return null
    db.rawQuery("SELECT id FROM budget_categories WHERE type = ? AND name = ?", arrayOf(type, name)).use { c ->
      if (c.moveToFirst()) return c.getString(0)
    }
    val id = newId("cat")
    db.execSQL(
      "INSERT INTO budget_categories (id, type, name, amount, created_at) VALUES (?, ?, ?, 0, ?)",
      arrayOf(id, type, name, isoNow())
    )
    return id
  }

  // Liquida la compra: inserta el gasto "Lista de compras", aplica su
  // efecto sobre wallet/presupuesto y archiva la lista como 'done'.
  // Todo ocurre dentro de una transacción SQLite: o se aplica completo, o
  // no se aplica nada (nunca deja al wallet a medio actualizar).
  fun finalizePurchase(
    context: Context,
    listId: String,
    amount: Double,
    method: String,
    cashAmount: Double?,
    origin: String,
    category: String,
    note: String?
  ): Boolean {
    val cycleId = getOpenCycleId(context) ?: return false
    val db = open(context) ?: return false
    var ok = false
    try {
      db.beginTransaction()
      val txId = newId("tx")
      val now = isoNow()
      // finalizePurchase antes insertaba el gasto de la lista sin llamar a
      // ensureCategory: si "Lista de compras" (u otra categoría elegida en
      // la liquidación) todavía no existía como fila de presupuesto,
      // applyWalletEffect no encontraba nada que actualizar y el cupo
      // correspondiente nunca se creaba/rastreaba -mismo bug que ya
      // tenían addIncome/addExpense, solo que aquí faltaba del todo-.
      val categoryType = if (origin == "secundario") "secundario" else "vital"
      val categoryId = ensureCategory(db, categoryType, category)
      db.execSQL(
        "INSERT INTO transactions (id, kind, amount, method, cash_amount, category, category_id, origin, note, created_at, cycle_id) VALUES (?, 'gasto', ?, ?, ?, ?, ?, ?, ?, ?, ?)",
        arrayOf(txId, amount, method, cashAmount, category, categoryId, origin, note, now, cycleId)
      )
      applyWalletEffect(db, "gasto", amount, method, cashAmount, origin, category, categoryId)
      db.execSQL("UPDATE lists SET status = 'done', completed_at = ? WHERE id = ?", arrayOf(now, listId))
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try {
        db.endTransaction()
      } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
    return ok
  }

  // Interruptor "Es una compra" desactivado: archiva la lista como 'done'
  // sin tocar wallet/presupuesto/transacciones -equivalente nativo de
  // completeList({ registerExpense: false }) en DataContext.tsx-.
  fun archiveListWithoutExpense(context: Context, listId: String): Boolean {
    val db = open(context) ?: return false
    var ok = false
    try {
      db.beginTransaction()
      db.execSQL("UPDATE lists SET status = 'done', completed_at = ? WHERE id = ?", arrayOf(isoNow(), listId))
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
    return ok
  }

  // Ventana nativa "Nuevo Ingreso" del menú de la burbuja. Los ingresos
  // siempre se acreditan a origin='cuenta' -igual que addIncome en
  // DataContext.tsx-, nunca afectan un cupo de Presupuesto.
  fun addIncome(context: Context, amount: Double, method: String, cashAmount: Double?, category: String, note: String?): Boolean {
    val cycleId = getOpenCycleId(context) ?: return false
    val db = open(context) ?: return false
    var ok = false
    try {
      db.beginTransaction()
      val cleanCategory = category.trim().ifEmpty { "Otros" }
      val categoryId = ensureCategory(db, "ingreso", cleanCategory)
      db.execSQL(
        "INSERT INTO transactions (id, kind, amount, method, cash_amount, category, category_id, origin, note, created_at, cycle_id) VALUES (?, 'ingreso', ?, ?, ?, ?, ?, 'cuenta', ?, ?, ?)",
        arrayOf(newId("tx"), amount, method, cashAmount, cleanCategory, categoryId, note, isoNow(), cycleId)
      )
      applyWalletEffect(db, "ingreso", amount, method, cashAmount, "cuenta", cleanCategory, categoryId)
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
    return ok
  }

  // Ventana nativa "Nuevo Gasto" del menú de la burbuja. La categoría se
  // crea con type='vital' (por defecto) o 'secundario'/'ingreso' según el
  // origen elegido, igual que gasto.tsx.
  fun addExpense(context: Context, amount: Double, method: String, cashAmount: Double?, origin: String, category: String, note: String?): Boolean {
    val cycleId = getOpenCycleId(context) ?: return false
    val db = open(context) ?: return false
    var ok = false
    try {
      db.beginTransaction()
      val cleanCategory = category.trim().ifEmpty { "Otros" }
      val categoryType = if (origin == "secundario") "secundario" else "vital"
      val categoryId = ensureCategory(db, categoryType, cleanCategory)
      db.execSQL(
        "INSERT INTO transactions (id, kind, amount, method, cash_amount, category, category_id, origin, note, created_at, cycle_id) VALUES (?, 'gasto', ?, ?, ?, ?, ?, ?, ?, ?, ?)",
        arrayOf(newId("tx"), amount, method, cashAmount, cleanCategory, categoryId, origin, note, isoNow(), cycleId)
      )
      applyWalletEffect(db, "gasto", amount, method, cashAmount, origin, cleanCategory, categoryId)
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
    return ok
  }

  // Ventana nativa "Nueva Nota" del menú de la burbuja: nota simple, sin
  // recordatorio -el selector de hora estricto solo existe en la app-.
  fun addNote(context: Context, subject: String, text: String): Boolean {
    val db = open(context) ?: return false
    var ok = false
    try {
      db.beginTransaction()
      db.execSQL(
        "INSERT INTO notes (id, subject, text, pinned, is_reminder, remind_at, lead_minutes, notification_id, done, completed_at, created_at) VALUES (?, ?, ?, 0, 0, NULL, 15, NULL, 0, NULL, ?)",
        arrayOf(newId("note"), subject.trim(), text.trim(), isoNow())
      )
      db.setTransactionSuccessful()
      ok = true
    } catch (_: Exception) {
      ok = false
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (ok) checkpointWal(db)
      db.close()
    }
    if (ok) NativeSync.emitDatabaseSyncRequired(context)
    return ok
  }

  // Ventana nativa "Nueva Lista" del menú de la burbuja (solo cuando no
  // hay ninguna lista en ejecución). Calcula el siguiente código
  // secuencial #L-00X igual que addList en DataContext.tsx -sobre el
  // mayor número ya usado, no sobre COUNT(*), para no repetir un código
  // ya mostrado tras un borrado- e inserta los ítems base (extra=0) del
  // constructor. Devuelve el id de la lista creada, o null si falló.
  fun createList(context: Context, title: String, items: List<String>): String? {
    val db = open(context) ?: return null
    var resultId: String? = null
    try {
      db.beginTransaction()
      var maxSeq = 0
      db.rawQuery("SELECT list_code FROM lists", null).use { c ->
        while (c.moveToNext()) {
          val code = c.getString(0) ?: continue
          val m = Regex("^L-(\\d+)$").find(code) ?: continue
          val n = m.groupValues[1].toIntOrNull() ?: continue
          if (n > maxSeq) maxSeq = n
        }
      }
      val listCode = "L-" + (maxSeq + 1).toString().padStart(3, '0')
      val id = newId("list")
      val now = isoNow()
      db.execSQL(
        "INSERT INTO lists (id, list_code, title, category, is_programmed, scheduled_at, lead_minutes, notification_id, status, created_at, cycle_id) VALUES (?, ?, ?, NULL, 0, NULL, 15, NULL, 'active', ?, ?)",
        arrayOf(id, listCode, title.trim(), now, getOpenCycleId(context))
      )
      for (item in items) {
        val clean = item.trim()
        if (clean.isEmpty()) continue
        db.execSQL(
          "INSERT INTO list_entries (id, list_id, text, done, extra, created_at) VALUES (?, ?, ?, 0, 0, ?)",
          arrayOf(newId("entry"), id, clean, isoNow())
        )
      }
      db.setTransactionSuccessful()
      resultId = id
    } catch (_: Exception) {
      resultId = null
    } finally {
      try { db.endTransaction() } catch (_: Exception) {
      }
      if (resultId != null) checkpointWal(db)
      db.close()
    }
    if (resultId != null) NativeSync.emitDatabaseSyncRequired(context)
    return resultId
  }
}
