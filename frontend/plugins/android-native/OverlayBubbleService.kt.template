  private fun openListExecutionPanel(listId: String) {
    closeMenu()
    execListId = listId
    execEditing = false
    execShowFinish = false
    execRegisterExpense = true
    execAmount = ""
    execCashAmount = ""
    execOrigin = "cuenta"
    execMethod = "efectivo"
    execNote = ""
    execNewItemText = ""
    execSubmitting = false
    renderExecutionPanel()
  }

  private fun renderExecutionPanel() {
    val listId = execListId ?: return collapseToBubble()
    val list = try { PanDb.getList(this, listId) } catch (_: Exception) { null }
    if (list == null || list.status != "in_progress") {
      collapseToBubble()
      return
    }

    val view = buildExecutionPanelView(list)
    val lp = WindowManager.LayoutParams(
      dp(300),
      WindowManager.LayoutParams.WRAP_CONTENT,
      overlayType(),
      0,
      PixelFormat.TRANSLUCENT
    )
    lp.gravity = Gravity.CENTER

    removeCurrentView()
    try {
      windowManager?.addView(view, lp)
      currentView = view
      currentParams = lp
    } catch (_: Exception) {
    }
  }

  private fun buildExecutionPanelView(list: PanDb.ListRow): View {
    val entries = try { PanDb.getEntries(this, list.id) } catch (_: Exception) { emptyList() }

    val root = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(14), dp(16), dp(16))
      background = GradientDrawable().apply {
        cornerRadius = dp(20).toFloat()
        setColor(Color.WHITE)
      }
    }

    // Encabezado: título + minimizar + editar.
    val header = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
    }
    header.addView(TextView(this).apply {
      text = if (list.listCode.isNotEmpty()) "#${list.listCode} · ${list.title}" else list.title
      setTextColor(Color.parseColor(COLOR_TEXT))
      textSize = 16f
      setTypeface(typeface, android.graphics.Typeface.BOLD)
      layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
      maxLines = 1
    })
    header.addView(TextView(this).apply {
      text = if (execEditing) "✓" else "✎"
      setTextColor(Color.parseColor(COLOR_BRAND))
      textSize = 16f
      setPadding(dp(10), dp(4), dp(10), dp(4))
      setOnClickListener {
        execEditing = !execEditing
        renderExecutionPanel()
      }
    })
    header.addView(TextView(this).apply {
      text = "–"
      setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
      textSize = 18f
      setPadding(dp(10), dp(4), dp(4), dp(4))
      setOnClickListener { collapseToBubble() }
    })
    root.addView(header)

    // Checklist con scroll (mismo tope visual que el modal en-app: ~280dp).
    val scroll = ScrollView(this).apply {
      layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(240))
    }
    val list_ = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(0, dp(8), 0, dp(8))
    }
    for (entry in entries) {
      list_.addView(buildEntryRow(entry))
    }
    scroll.addView(list_)
    root.addView(scroll)

    // Campo para añadir ítems nuevos (en naranja), visible en modo Editar.
    if (execEditing) {
      val addRow = LinearLayout(this).apply {
        orientation = LinearLayout.HORIZONTAL
        gravity = Gravity.CENTER_VERTICAL
        setPadding(dp(4), dp(6), dp(4), dp(6))
        background = GradientDrawable().apply {
          cornerRadius = dp(10).toFloat()
          setColor(Color.parseColor(COLOR_SURFACE_ALT))
        }
      }
      val input = EditText(this).apply {
        hint = "Añadir ítem"
        setText(execNewItemText)
        setTextColor(Color.parseColor(COLOR_ACCENT))
        setHintTextColor(Color.parseColor(COLOR_TEXT_MUTED))
        setSingleLine(true)
        setBackgroundColor(Color.TRANSPARENT)
        layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
        addTextChangedListener(simpleWatcher { execNewItemText = it })
      }
      addRow.addView(input)
      addRow.addView(TextView(this).apply {
        text = "＋"
        setTextColor(Color.WHITE)
        textSize = 16f
        setPadding(dp(10), dp(4), dp(10), dp(4))
        background = GradientDrawable().apply {
          shape = GradientDrawable.OVAL
          setColor(Color.parseColor(COLOR_BRAND))
        }
        setOnClickListener {
          val clean = execNewItemText.trim()
          if (clean.isNotEmpty()) {
            execNewItemText = ""
            runSubmit({ PanDb.addEntry(this@OverlayBubbleService, list.id, clean) }) { renderExecutionPanel() }
          }
        }
      })
      root.addView(addRow)
    }

    root.addView(View(this).apply {
      layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(12))
    })

    if (!execShowFinish) {
      root.addView(actionButton("Finalizar lista", COLOR_BRAND) {
        execShowFinish = true
        renderExecutionPanel()
      })
    } else {
      root.addView(buildSettlementForm(list))
    }

    return root
  }

  private fun buildEntryRow(entry: PanDb.EntryRow): View {
    val row = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(4), dp(6), dp(4), dp(6))
    }
    if (!execEditing) {
      row.addView(TextView(this).apply {
        text = if (entry.done) "●" else "○"
        setTextColor(Color.parseColor(if (entry.done) COLOR_SUCCESS else COLOR_TEXT_MUTED))
        textSize = 16f
        setPadding(0, 0, dp(10), 0)
        setOnClickListener {
          runSubmit({ PanDb.toggleEntryDone(this@OverlayBubbleService, entry.id, !entry.done); true }) { renderExecutionPanel() }
        }
      })
    }
    row.addView(TextView(this).apply {
      text = entry.text
      setTextColor(Color.parseColor(if (entry.extra) COLOR_ACCENT else COLOR_TEXT))
      textSize = 14f
      layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
      if (entry.done && !execEditing) paintFlags = paintFlags or android.graphics.Paint.STRIKE_THRU_TEXT_FLAG
    })
    // Bloqueo estructural: solo los ítems 'extra' muestran la X de quitar.
    if (execEditing && entry.extra) {
      row.addView(TextView(this).apply {
        text = "✕"
        setTextColor(Color.parseColor(COLOR_ERROR))
        textSize = 14f
        setPadding(dp(10), dp(4), dp(4), dp(4))
        setOnClickListener {
          runSubmit({ PanDb.deleteExtraEntry(this@OverlayBubbleService, entry.id) }) { renderExecutionPanel() }
        }
      })
    }
    return row
  }

  private fun buildSettlementForm(list: PanDb.ListRow): View {
    val col = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }

    // Interruptor "Es una compra": si se desactiva, se archiva la lista
    // sin registrar ningún gasto -equivalente nativo del switch homónimo
    // en CompraOverlayModal.tsx-.
    val switchRow = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(0, 0, 0, dp(6))
    }
    val switchTextCol = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
    }
    switchTextCol.addView(TextView(this).apply {
      text = "Es una compra"
      setTextColor(Color.parseColor(COLOR_TEXT))
      textSize = 13.5f
      setTypeface(typeface, android.graphics.Typeface.BOLD)
    })
    switchTextCol.addView(TextView(this).apply {
      text = if (execRegisterExpense) "Se registrará como gasto" else "Se archivará sin generar gasto"
      setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
      textSize = 11f
    })
    switchRow.addView(switchTextCol)
    switchRow.addView(android.widget.Switch(this).apply {
      isChecked = execRegisterExpense
      setOnCheckedChangeListener { _, checked ->
        execRegisterExpense = checked
        renderExecutionPanel()
      }
    })
    col.addView(switchRow)

    if (execRegisterExpense) {
      col.addView(fieldLabel("Monto total gastado"))
      col.addView(EditText(this).apply {
        hint = "0.00"
        setText(execAmount)
        inputType = android.text.InputType.TYPE_CLASS_NUMBER or android.text.InputType.TYPE_NUMBER_FLAG_DECIMAL
        setBackgroundColor(Color.parseColor(COLOR_SURFACE_ALT))
        setPadding(dp(10), dp(8), dp(10), dp(8))
        addTextChangedListener(simpleWatcher { execAmount = it })
      })

      col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(8)) })
      col.addView(segmentedRow(listOf("efectivo" to "Efectivo", "transferencia" to "Transferencia", "mixto" to "Mixto"), execMethod) {
        execMethod = it
        renderExecutionPanel()
      })

      if (execMethod == "mixto") {
        col.addView(fieldLabel("Efectivo pagado"))
        col.addView(EditText(this).apply {
          hint = "0.00"
          setText(execCashAmount)
          inputType = android.text.InputType.TYPE_CLASS_NUMBER or android.text.InputType.TYPE_NUMBER_FLAG_DECIMAL
          setBackgroundColor(Color.parseColor(COLOR_SURFACE_ALT))
          setPadding(dp(10), dp(8), dp(10), dp(8))
          addTextChangedListener(simpleWatcher { execCashAmount = it })
        })
        val amt = execAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
        val cash = execCashAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
        val digital = if (amt - cash > 0) amt - cash else 0.0
        col.addView(TextView(this).apply {
          text = "Digital (calculado): S/ " + String.format(Locale.US, "%.2f", digital)
          setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
          textSize = 12f
          setPadding(0, dp(4), 0, 0)
        })
      }

      col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(10)) })
      col.addView(fieldLabel("Origen del dinero"))
      col.addView(originGrid(execOrigin) {
        execOrigin = it
        renderExecutionPanel()
      })

      col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(10)) })
      col.addView(fieldLabel("Nota (opcional)"))
      col.addView(EditText(this).apply {
        hint = "Detalle..."
        setText(execNote)
        setBackgroundColor(Color.parseColor(COLOR_SURFACE_ALT))
        setPadding(dp(10), dp(8), dp(10), dp(8))
        addTextChangedListener(simpleWatcher { execNote = it })
      })
    }

    col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(12)) })
    val confirmLabel = when {
      execSubmitting -> "Guardando..."
      execRegisterExpense -> "Confirmar y registrar gasto"
      else -> "Finalizar sin registrar gasto"
    }
    col.addView(actionButton(confirmLabel, if (execRegisterExpense) COLOR_SUCCESS else COLOR_BRAND, enabled = !execSubmitting) {
      confirmSettlement(list)
    })

    return col
  }

  // Bloqueo estricto contra doble pulsación: mientras execSubmitting es
  // true, el botón queda deshabilitado a nivel de View (ver actionButton)
  // y la escritura en SQLite corre en un hilo de fondo (runSubmit) para
  // que el toque adicional nunca quede encolado esperando a que el hilo
  // principal se libere -evitando duplicar el gasto.
  private fun confirmSettlement(list: PanDb.ListRow) {
    if (execSubmitting) return

    if (!execRegisterExpense) {
      execSubmitting = true
      renderExecutionPanel()
      runSubmit({ PanDb.archiveListWithoutExpense(this, list.id) }) { archived ->
        execSubmitting = false
        if (archived) collapseToBubble() else renderExecutionPanel()
      }
      return
    }

    val amount = execAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
    if (amount <= 0) return

    execSubmitting = true
    renderExecutionPanel()

    val cash = if (execMethod == "mixto") execCashAmount.replace(",", ".").toDoubleOrNull() ?: 0.0 else null
    val codeTag = if (list.listCode.isNotEmpty()) "Gasto Lista #${list.listCode}" else "Gasto de lista"
    val userNote = execNote.trim()
    val note = if (userNote.isNotEmpty()) "$userNote ($codeTag)" else codeTag

    runSubmit({ PanDb.finalizePurchase(this, list.id, amount, execMethod, cash, execOrigin, "Lista de compras", note) }) { ok ->
      execSubmitting = false
      if (ok) {
        collapseToBubble()
      } else {
        // Falló la escritura (base no disponible, etc.): se queda en el
        // formulario para que el usuario pueda reintentar, en vez de perder
        // silenciosamente la liquidación.
        renderExecutionPanel()
      }
    }
  }

