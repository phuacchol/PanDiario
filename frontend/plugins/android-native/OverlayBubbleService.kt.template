  private fun fieldLabel(text: String): View {
    return TextView(this).apply {
      this.text = text
      setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
      textSize = 12f
      setPadding(dp(2), dp(6), 0, dp(2))
    }
  }

  private fun segmentedRow(options: List<Pair<String, String>>, value: String, onChange: (String) -> Unit): View {
    val row = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      background = GradientDrawable().apply {
        cornerRadius = dp(10).toFloat()
        setColor(Color.parseColor(COLOR_SURFACE_ALT))
      }
      setPadding(dp(3), dp(3), dp(3), dp(3))
    }
    for ((key, label) in options) {
      val active = key == value
      row.addView(TextView(this).apply {
        text = label
        textSize = 12f
        gravity = Gravity.CENTER
        setTextColor(Color.parseColor(if (active) "#FFFFFF" else COLOR_TEXT_MUTED))
        layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
        setPadding(dp(4), dp(8), dp(4), dp(8))
        if (active) {
          background = GradientDrawable().apply {
            cornerRadius = dp(8).toFloat()
            setColor(Color.parseColor(COLOR_BRAND))
          }
        }
        setOnClickListener { onChange(key) }
      })
    }
    return row
  }

  private fun originGrid(value: String, onChange: (String) -> Unit): View {
    val options = listOf(
      "cuenta" to "Cuenta Actual",
      "vital" to "Presupuesto Vital",
      "secundario" to "Presupuesto Secundario",
      "caja_chica" to "Caja Chica",
      "ahorro" to "Ahorro"
    )
    val grid = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
    }
    var row: LinearLayout? = null
    options.forEachIndexed { index, (key, label) ->
      if (index % 3 == 0) {
        row = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
        grid.addView(row)
      }
      val active = key == value
      row?.addView(TextView(this).apply {
        text = label
        textSize = 10.5f
        gravity = Gravity.CENTER
        setTextColor(Color.parseColor(if (active) "#FFFFFF" else COLOR_TEXT_MUTED))
        layoutParams = LinearLayout.LayoutParams(0, dp(48), 1f).apply {
          setMargins(dp(3), dp(3), dp(3), dp(3))
        }
        background = GradientDrawable().apply {
          cornerRadius = dp(8).toFloat()
          setColor(Color.parseColor(if (active) COLOR_BRAND else COLOR_SURFACE_ALT))
        }
        setOnClickListener { onChange(key) }
      })
    }
    return grid
  }

  // enabled=false bloquea el toque a nivel de View (isClickable=false), no
  // solo con una bandera lógica: mientras la escritura en SQLite corre en
  // segundo plano (ver confirmGenericPanel/confirmSettlement), el sistema
  // de entrada de Android descarta cualquier toque adicional sobre este
  // botón en vez de encolarlo para cuando el hilo principal quede libre
  // -antes, con el guard solo lógico (`if (submitting) return`) y la
  // escritura corriendo en el hilo principal, una segunda pulsación
  // encolada podía llegar recién cuando la primera ya había terminado y
  // reseteado la bandera, colándose como un registro duplicado real-.
  private fun actionButton(label: String, colorHex: String, enabled: Boolean = true, onClick: () -> Unit): View {
    return TextView(this).apply {
      text = label
      setTextColor(Color.WHITE)
      textSize = 14f
      gravity = Gravity.CENTER
      alpha = if (enabled) 1f else 0.6f
      isClickable = enabled
      setPadding(dp(12), dp(12), dp(12), dp(12))
      background = GradientDrawable().apply {
        cornerRadius = dp(12).toFloat()
        setColor(Color.parseColor(colorHex))
      }
      setOnClickListener { if (enabled) onClick() }
    }
  }

  private fun simpleWatcher(onChange: (String) -> Unit): TextWatcher {
    return object : TextWatcher {
      override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
      override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
      override fun afterTextChanged(s: Editable?) {
        onChange(s?.toString() ?: "")
      }
    }
  }

  // Solo se usa para la burbuja. Arrastrar más allá del umbral muestra la
  // zona de cierre (X) abajo-centro; soltar sobre ella destruye el
  // servicio, soltar en cualquier otro punto pega la burbuja al borde
  // lateral más cercano con una animación corta. Sin arrastre real, el
  // toque se trata como click (alterna el menú).
  private fun attachDragAndClick(view: View, lp: WindowManager.LayoutParams, onClick: () -> Unit) {
    var initialX = 0
    var initialY = 0
    var initialTouchX = 0f
    var initialTouchY = 0f
    var moved = false
    val bubbleSize = dp(56)

    view.setOnTouchListener { v, event ->
      when (event.action) {
        MotionEvent.ACTION_DOWN -> {
          initialX = lp.x
          initialY = lp.y
          initialTouchX = event.rawX
          initialTouchY = event.rawY
          moved = false
          true
        }
        MotionEvent.ACTION_MOVE -> {
          val dx = (event.rawX - initialTouchX).toInt()
          val dy = (event.rawY - initialTouchY).toInt()
          if (abs(dx) > 8 || abs(dy) > 8) {
            if (!moved) {
              moved = true
              if (menuOpen) closeMenu()
              showDismissZone()
            }
          }
          lp.x = initialX + dx
          // Cota superior: nunca deja que la burbuja se meta bajo la barra
          // de estado -ahí el sistema le roba el touch al panel de
          // notificaciones y la burbuja queda inalcanzable-. Se aplica en
          // tiempo real durante el arrastre, no solo al soltar.
          lp.y = (initialY + dy).coerceAtLeast(minBubbleY())
          try {
            windowManager?.updateViewLayout(v, lp)
          } catch (_: Exception) {
          }
          if (moved) highlightDismissZone(isOverDismissZone(lp, bubbleSize))
          true
        }
        MotionEvent.ACTION_UP -> {
          if (!moved) {
            onClick()
          } else {
            val overDismiss = isOverDismissZone(lp, bubbleSize)
            hideDismissZone()
            if (overDismiss) {
              stopSelf()
            } else {
              // Red de seguridad además del clamp de ACTION_MOVE: si por
              // cualquier motivo la burbuja quedó por encima del límite,
              // rebota de vuelta con una animación corta -igual que el
              // imán de borde en X-.
              if (lp.y < minBubbleY()) animateBubbleY(v, lp, minBubbleY())
              snapToNearestEdge(v, lp)
            }
          }
          true
        }
        MotionEvent.ACTION_CANCEL -> {
          hideDismissZone()
          true
        }
        else -> false
      }
    }
  }

  // -------------------------------------------------------------------
  // Zona de cierre (X) al arrastrar + imán de borde al soltar.
  // -------------------------------------------------------------------

  private fun dismissZoneRect(): android.graphics.Rect {
    val screen = resources.displayMetrics
    val size = dp(64)
    val bottomMargin = dp(40)
    val left = (screen.widthPixels - size) / 2
    val top = screen.heightPixels - bottomMargin - size
    return android.graphics.Rect(left, top, left + size, top + size)
  }

  private fun showDismissZone() {
    if (dismissZoneView != null) return
    val size = dp(64)
    val zone = TextView(this).apply {
      text = "✕"
      gravity = Gravity.CENTER
      setTextColor(Color.WHITE)
      textSize = 22f
      background = GradientDrawable().apply {
        shape = GradientDrawable.OVAL
        setColor(Color.argb(200, 40, 40, 40))
      }
    }
    val lp = WindowManager.LayoutParams(
      size,
      size,
      overlayType(),
      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE,
      PixelFormat.TRANSLUCENT
    )
    lp.gravity = Gravity.TOP or Gravity.START
    val rect = dismissZoneRect()
    lp.x = rect.left
    lp.y = rect.top
    try {
      windowManager?.addView(zone, lp)
      dismissZoneView = zone
      dismissActive = false
    } catch (_: Exception) {
    }
  }

  private fun highlightDismissZone(active: Boolean) {
    if (active == dismissActive) return
    dismissActive = active
    val view = dismissZoneView ?: return
    (view as? TextView)?.background = GradientDrawable().apply {
      shape = GradientDrawable.OVAL
      setColor(Color.parseColor(if (active) COLOR_ERROR else "#282828"))
    }
    view.scaleX = if (active) 1.25f else 1f
    view.scaleY = if (active) 1.25f else 1f
  }

  private fun hideDismissZone() {
    val view = dismissZoneView
    if (view != null) {
      try { windowManager?.removeView(view) } catch (_: Exception) {
      }
    }
    dismissZoneView = null
    dismissActive = false
  }

  private fun isOverDismissZone(bubbleLp: WindowManager.LayoutParams, bubbleSize: Int): Boolean {
    val rect = dismissZoneRect()
    // Margen de tolerancia generoso: basta con que el centro de la
    // burbuja entre en la zona ampliada, no un solapamiento exacto de
    // píxeles -más fácil de acertar arrastrando con el dedo-.
    val margin = dp(24)
    val expanded = android.graphics.Rect(rect.left - margin, rect.top - margin, rect.right + margin, rect.bottom + margin)
    val centerX = bubbleLp.x + bubbleSize / 2
    val centerY = bubbleLp.y + bubbleSize / 2
    return expanded.contains(centerX, centerY)
  }

  private fun snapToNearestEdge(view: View, lp: WindowManager.LayoutParams) {
    val screen = resources.displayMetrics
    val bubbleSize = dp(56)
    val centerX = lp.x + bubbleSize / 2
    val targetX = if (centerX < screen.widthPixels / 2) 0 else screen.widthPixels - bubbleSize
    val startX = lp.x
    if (startX == targetX) return
    val animator = ValueAnimator.ofInt(startX, targetX)
    animator.duration = 220
    animator.addUpdateListener { anim ->
      lp.x = anim.animatedValue as Int
      try { windowManager?.updateViewLayout(view, lp) } catch (_: Exception) {
      }
    }
    animator.start()
  }

  // Altura real de la barra de estado del dispositivo (varía por
  // fabricante/muesca de cámara) + un margen de seguridad, para que la
  // burbuja nunca quede debajo de ella -ahí el sistema prioriza el gesto
  // de abrir el panel de notificaciones y la burbuja queda inalcanzable-.
  private fun minBubbleY(): Int {
    val resourceId = resources.getIdentifier("status_bar_height", "dimen", "android")
    val statusBarHeight = if (resourceId > 0) resources.getDimensionPixelSize(resourceId) else 0
    return statusBarHeight + dp(16)
  }

  private fun animateBubbleY(view: View, lp: WindowManager.LayoutParams, targetY: Int) {
    val startY = lp.y
    if (startY == targetY) return
    val animator = ValueAnimator.ofInt(startY, targetY)
    animator.duration = 220
    animator.addUpdateListener { anim ->
      lp.y = anim.animatedValue as Int
      try { windowManager?.updateViewLayout(view, lp) } catch (_: Exception) {
      }
    }
    animator.start()
  }
}
