// Burbuja flotante fuera de la app (overlay, estilo "call-head" de
// Messenger). Ícono: pan_burbuja (o pan_avatar de respaldo), recortado en
// círculo. Al tocarla despliega una tarjeta con 3 accesos (Lista activa,
// Nueva nota, Calculadora) + una barra inferior de micrófono a ancho
// completo. Si hay una lista "en ejecución" (Play presionado desde la
// app), "Lista activa" abre un segundo panel flotante -checklist +
// liquidación- que lee/escribe la misma base SQLite de la app sin
// necesidad de traerla al frente. El micrófono deep-linkea a /voice -el
// reconocimiento de voz en sí ya vive ahí, con push-to-talk real dentro de
// la app-.
class OverlayBubbleService : Service() {

  companion object {
    @Volatile
    var isRunning: Boolean = false
    private const val CHANNEL_ID = "pandiario_overlay_bubble"
    private const val NOTIF_ID = 4821

    // Paleta exacta de src/theme/theme.ts (LIGHT), para que el overlay
    // nativo se vea consistente con la app.
    private const val COLOR_BRAND = "#6C7FD8"
    private const val COLOR_ACCENT = "#E67E22" // ítems extra / naranja
    private const val COLOR_SUCCESS = "#48C78E"
    private const val COLOR_ERROR = "#E55050"
    private const val COLOR_TEXT = "#12102A"
    private const val COLOR_TEXT_MUTED = "#8A8FA3"
    private const val COLOR_SURFACE_ALT = "#F2F3F8"
  }

  private var windowManager: WindowManager? = null
  private var currentView: View? = null
  private var currentParams: WindowManager.LayoutParams? = null

  // Menú desplegable: una segunda ventana superpuesta, independiente de la
  // burbuja (que nunca se retira mientras el menú está abierto -así el
  // menú se ancla junto a ella sin taparla nunca-). Tocar la burbuja
  // alterna abrirlo/cerrarlo.
  private var menuView: View? = null
  private var menuOpen = false

  // Estado del panel de ejecución de lista (se reconstruye la vista
  // completa en cada cambio; es más simple y confiable en Views nativas
  // imperativas que intentar un diff manual).
  private var execListId: String? = null
  private var execEditing = false
  private var execShowFinish = false
  private var execRegisterExpense = true
  private var execAmount = ""
  private var execMethod = "efectivo"
  private var execCashAmount = ""
  private var execOrigin = "cuenta"
  private var execNote = ""
  private var execNewItemText = ""
  @Volatile
  private var execSubmitting = false

  override fun onBind(intent: Intent?): IBinder? = null

  override fun onCreate() {
    super.onCreate()
    isRunning = true
    startForegroundWithNotification()

    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && !Settings.canDrawOverlays(this)) {
      stopSelf()
      return
    }

    windowManager = getSystemService(WINDOW_SERVICE) as? WindowManager
    showCollapsedBubble()
  }

  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
    return START_STICKY
  }

  override fun onDestroy() {
    super.onDestroy()
    isRunning = false
    removeCurrentView()
  }

  private fun startForegroundWithNotification() {
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
      val channel = NotificationChannel(CHANNEL_ID, "Burbuja PanDiario", NotificationManager.IMPORTANCE_MIN)
      val manager = getSystemService(NotificationManager::class.java)
      manager?.createNotificationChannel(channel)
    }

    val openAppIntent = packageManager.getLaunchIntentForPackage(packageName) ?: Intent()
    val pendingIntent = PendingIntent.getActivity(
      this,
      0,
      openAppIntent,
      PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
    )

    val notification = NotificationCompat.Builder(this, CHANNEL_ID)
      .setContentTitle("PanDiario")
      .setContentText("Burbuja de acceso rápido activa")
      .setSmallIcon(applicationInfo.icon)
      .setContentIntent(pendingIntent)
      .setOngoing(true)
      .build()

    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
      startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)
    } else {
      startForeground(NOTIF_ID, notification)
    }
  }

  private fun dp(value: Int): Int {
    val density = resources.displayMetrics.density
    return (value * density).toInt()
  }

  private fun overlayType(): Int {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
      WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
    } else {
      @Suppress("DEPRECATION")
      WindowManager.LayoutParams.TYPE_PHONE
    }
  }

  private fun removeCurrentView() {
    val view = currentView
    if (view != null) {
      try {
        windowManager?.removeView(view)
      } catch (_: Exception) {
      }
    }
    currentView = null
  }

  // -------------------------------------------------------------------
  // Burbuja colapsada
  // -------------------------------------------------------------------

  private fun circularBitmapDrawable(sourceResId: Int, sizePx: Int): BitmapDrawable? {
    return try {
      val original = android.graphics.BitmapFactory.decodeResource(resources, sourceResId) ?: return null
      val output = Bitmap.createBitmap(sizePx, sizePx, Bitmap.Config.ARGB_8888)
      val canvas = Canvas(output)
      val paint = Paint(Paint.ANTI_ALIAS_FLAG)
      val shader = BitmapShader(
        Bitmap.createScaledBitmap(original, sizePx, sizePx, true),
        Shader.TileMode.CLAMP,
        Shader.TileMode.CLAMP
      )
      paint.shader = shader
      val radius = sizePx / 2f
      canvas.drawCircle(radius, radius, radius, paint)
      BitmapDrawable(resources, output)
    } catch (_: Exception) {
      null
    }
  }

  private fun showCollapsedBubble() {
    val size = dp(56)
    val iconResId = resources.getIdentifier("pan_burbuja", "drawable", packageName)
    val circular = if (iconResId != 0) circularBitmapDrawable(iconResId, size) else null

    val bubble = ImageView(this).apply {
      if (circular != null) {
        setImageDrawable(circular)
        scaleType = ImageView.ScaleType.CENTER_CROP
      } else {
        background = GradientDrawable().apply {
          shape = GradientDrawable.OVAL
          setColor(Color.parseColor(COLOR_BRAND))
        }
        setImageResource(applicationInfo.icon)
        setPadding(dp(8), dp(8), dp(8), dp(8))
        scaleType = ImageView.ScaleType.CENTER_INSIDE
      }
    }

    val lp = WindowManager.LayoutParams(
      size,
      size,
      overlayType(),
      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
      PixelFormat.TRANSLUCENT
    )
    lp.gravity = Gravity.TOP or Gravity.START
    lp.x = currentParams?.x ?: 0
    lp.y = currentParams?.y ?: dp(220)

    attachDragAndClick(bubble, lp) { toggleMenu() }

    removeCurrentView()
    try {
      windowManager?.addView(bubble, lp)
      currentView = bubble
      currentParams = lp
    } catch (_: Exception) {
    }
  }

  private fun collapseToBubble() {
    closeMenu()
    execListId = null
    execEditing = false
    execShowFinish = false
    execRegisterExpense = true
    execAmount = ""
    execCashAmount = ""
    execNote = ""
    execNewItemText = ""
    execSubmitting = false
    removeCurrentView()
    showCollapsedBubble()
  }

  // -------------------------------------------------------------------
  // Menú desplegable (estilo Messenger call-head): una ventana aparte que
  // se ancla junto a la burbuja -arriba o abajo, según el espacio
  // disponible en pantalla- sin retirarla nunca. Tocar la burbuja alterna
  // abrir/cerrar.
  // -------------------------------------------------------------------

  private fun toggleMenu() {
    if (menuOpen) closeMenu() else openMenu()
  }

  private fun openMenu() {
    closeMenu()
    val bubble = currentParams ?: return
    val panel = buildMenuPanelView()

    val panelWidth = dp(230)
    val panelHeightEstimate = dp(300)
    val bubbleSize = dp(56)
    val screen = resources.displayMetrics
    val margin = dp(8)

    val spaceBelow = screen.heightPixels - (bubble.y + bubbleSize)
    val anchorBelow = spaceBelow >= panelHeightEstimate
    val panelY = if (anchorBelow) {
      bubble.y + bubbleSize + margin
    } else {
      (bubble.y - panelHeightEstimate - margin).coerceAtLeast(margin)
    }

    var panelX = bubble.x
    if (panelX + panelWidth > screen.widthPixels) panelX = screen.widthPixels - panelWidth - margin
    if (panelX < margin) panelX = margin

    val lp = WindowManager.LayoutParams(
      panelWidth,
      WindowManager.LayoutParams.WRAP_CONTENT,
      overlayType(),
      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
      PixelFormat.TRANSLUCENT
    )
    lp.gravity = Gravity.TOP or Gravity.START
    lp.x = panelX
    lp.y = panelY

    try {
      windowManager?.addView(panel, lp)
      menuView = panel
      menuOpen = true
    } catch (_: Exception) {
    }
  }

  private fun closeMenu() {
    val view = menuView
    if (view != null) {
      try { windowManager?.removeView(view) } catch (_: Exception) {
      }
    }
    menuView = null
    menuOpen = false
  }

  private fun buildMenuPanelView(): View {
    val root = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      background = GradientDrawable().apply {
        cornerRadius = dp(18).toFloat()
        setColor(Color.WHITE)
      }
      clipToOutline = true
    }

    val inProgress = try { PanDb.getInProgressList(this) } catch (_: Exception) { null }

    root.addView(menuRow("💰", "Ingresos", null) { openApp("ingreso", floating = true) })
    root.addView(menuRow("💸", "Gastos", null) { openApp("gasto", floating = true) })
    root.addView(menuRow("📝", "Notas", null) { openApp("nota", floating = true) })
    root.addView(
      menuRow(
        "📋",
        "Listas",
        inProgress?.let { "En curso: ${it.title}" },
      ) {
        if (inProgress != null) openListExecutionPanel(inProgress.id) else openApp("lista", floating = true)
      }
    )

    root.addView(View(this).apply {
      layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(1))
      setBackgroundColor(Color.parseColor("#EEEEF2"))
    })

    // Botón inferior destacado a ancho completo, con push-to-talk: al
    // soltar (o al tocar) abre el panel de voz -reutiliza voice.tsx, donde
    // ya existe grabación real mientras se mantiene presionado- como
    // ventana flotante en vez de a pantalla completa.
    val micBar = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER
      setPadding(dp(14), dp(14), dp(14), dp(14))
      background = GradientDrawable().apply {
        setColor(Color.parseColor(COLOR_BRAND))
        cornerRadii = floatArrayOf(0f, 0f, 0f, 0f, dp(18).toFloat(), dp(18).toFloat(), dp(18).toFloat(), dp(18).toFloat())
      }
    }
    micBar.addView(TextView(this).apply {
      text = "🎙  Hablar"
      setTextColor(Color.WHITE)
      textSize = 15f
      gravity = Gravity.CENTER
    })
    var micPressed = false
    micBar.setOnTouchListener { v, event ->
      when (event.action) {
        MotionEvent.ACTION_DOWN -> {
          micPressed = true
          v.alpha = 0.75f
          true
        }
        MotionEvent.ACTION_UP -> {
          v.alpha = 1f
          if (micPressed) openApp("voice", floating = true)
          micPressed = false
          true
        }
        MotionEvent.ACTION_CANCEL -> {
          v.alpha = 1f
          micPressed = false
          true
        }
        else -> false
      }
    }
    root.addView(micBar)

    return root
  }

  private fun menuRow(icon: String, title: String, subtitle: String?, onClick: () -> Unit): View {
    val row = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(14), dp(10), dp(14), dp(10))
      isClickable = true
      isFocusable = true
      setOnClickListener { onClick() }
    }
    row.addView(TextView(this).apply {
      text = icon
      textSize = 18f
      setPadding(0, 0, dp(12), 0)
    })
    val textCol = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
    textCol.addView(TextView(this).apply {
      text = title
      setTextColor(Color.parseColor(COLOR_TEXT))
      textSize = 14f
    })
    if (!subtitle.isNullOrBlank()) {
      textCol.addView(TextView(this).apply {
        text = subtitle
        setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
        textSize = 11f
        maxLines = 1
      })
    }
    row.addView(textCol)
    return row
  }

  // floating=true lanza la misma pantalla React Native (ingreso.tsx,
  // gasto.tsx, nota.tsx, lista.tsx, voice.tsx vía app/quick/[action].tsx)
  // a través del alias de MainActivity con tema de diálogo flotante
  // (Theme.PanDiario.FloatingDialog, ver withOverlayBubble.js): se ve como
  // una tarjeta superpuesta sobre lo que esté en pantalla, sin tomarla por
  // completo. La burbuja y su menú solo se cierran -nunca se reconstruyen-
  // porque la ventana flotante se dibuja encima, no en su lugar.
  private fun openApp(action: String, floating: Boolean = false) {
    closeMenu()
    val uri = Uri.parse("pandiario://quick/$action")
    val intent = Intent(Intent.ACTION_VIEW, uri).apply {
      addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
      if (floating) {
        component = android.content.ComponentName(packageName, "$packageName.overlay.FloatingDialogAlias")
        putExtra("panFloating", true)
      } else {
        setPackage(packageName)
      }
    }
    try {
      startActivity(intent)
    } catch (_: Exception) {
    }
  }

  // -------------------------------------------------------------------
  // Panel flotante de Lista en ejecución (checklist + liquidación) -
  // ventana superpuesta sobre el sistema, sin abrir la app.
  // -------------------------------------------------------------------

  private fun openListExecutionPanel(listId: String) {
    closeMenu()
    execListId = listId
    execEditing = false
    execShowFinish = false
    execRegisterExpense = true
    execAmount = ""
    execCashAmount = ""
    execOrigin = "cuenta"
    execMethod = "efectivo"
    execNote = ""
    execNewItemText = ""
    execSubmitting = false
    renderExecutionPanel()
  }

  private fun renderExecutionPanel() {
    val listId = execListId ?: return collapseToBubble()
    val list = try { PanDb.getList(this, listId) } catch (_: Exception) { null }
    if (list == null || list.status != "in_progress") {
      collapseToBubble()
      return
    }

    val view = buildExecutionPanelView(list)
    val lp = WindowManager.LayoutParams(
      dp(300),
      WindowManager.LayoutParams.WRAP_CONTENT,
      overlayType(),
      0,
      PixelFormat.TRANSLUCENT
    )
    lp.gravity = Gravity.CENTER

    removeCurrentView()
    try {
      windowManager?.addView(view, lp)
      currentView = view
      currentParams = lp
    } catch (_: Exception) {
    }
  }

  private fun buildExecutionPanelView(list: PanDb.ListRow): View {
    val entries = try { PanDb.getEntries(this, list.id) } catch (_: Exception) { emptyList() }

    val root = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(dp(16), dp(14), dp(16), dp(16))
      background = GradientDrawable().apply {
        cornerRadius = dp(20).toFloat()
        setColor(Color.WHITE)
      }
    }

    // Encabezado: título + minimizar + editar.
    val header = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
    }
    header.addView(TextView(this).apply {
      text = if (list.listCode.isNotEmpty()) "#${list.listCode} · ${list.title}" else list.title
      setTextColor(Color.parseColor(COLOR_TEXT))
      textSize = 16f
      setTypeface(typeface, android.graphics.Typeface.BOLD)
      layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
      maxLines = 1
    })
    header.addView(TextView(this).apply {
      text = if (execEditing) "✓" else "✎"
      setTextColor(Color.parseColor(COLOR_BRAND))
      textSize = 16f
      setPadding(dp(10), dp(4), dp(10), dp(4))
      setOnClickListener {
        execEditing = !execEditing
        renderExecutionPanel()
      }
    })
    header.addView(TextView(this).apply {
      text = "–"
      setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
      textSize = 18f
      setPadding(dp(10), dp(4), dp(4), dp(4))
      setOnClickListener { collapseToBubble() }
    })
    root.addView(header)

    // Checklist con scroll (mismo tope visual que el modal en-app: ~280dp).
    val scroll = ScrollView(this).apply {
      layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(240))
    }
    val list_ = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      setPadding(0, dp(8), 0, dp(8))
    }
    for (entry in entries) {
      list_.addView(buildEntryRow(entry))
    }
    scroll.addView(list_)
    root.addView(scroll)

    // Campo para añadir ítems nuevos (en naranja), visible en modo Editar.
    if (execEditing) {
      val addRow = LinearLayout(this).apply {
        orientation = LinearLayout.HORIZONTAL
        gravity = Gravity.CENTER_VERTICAL
        setPadding(dp(4), dp(6), dp(4), dp(6))
        background = GradientDrawable().apply {
          cornerRadius = dp(10).toFloat()
          setColor(Color.parseColor(COLOR_SURFACE_ALT))
        }
      }
      val input = EditText(this).apply {
        hint = "Añadir ítem"
        setText(execNewItemText)
        setTextColor(Color.parseColor(COLOR_ACCENT))
        setHintTextColor(Color.parseColor(COLOR_TEXT_MUTED))
        setSingleLine(true)
        setBackgroundColor(Color.TRANSPARENT)
        layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
        addTextChangedListener(simpleWatcher { execNewItemText = it })
      }
      addRow.addView(input)
      addRow.addView(TextView(this).apply {
        text = "＋"
        setTextColor(Color.WHITE)
        textSize = 16f
        setPadding(dp(10), dp(4), dp(10), dp(4))
        background = GradientDrawable().apply {
          shape = GradientDrawable.OVAL
          setColor(Color.parseColor(COLOR_BRAND))
        }
        setOnClickListener {
          val clean = execNewItemText.trim()
          if (clean.isNotEmpty()) {
            try { PanDb.addEntry(this@OverlayBubbleService, list.id, clean) } catch (_: Exception) {}
            execNewItemText = ""
            renderExecutionPanel()
          }
        }
      })
      root.addView(addRow)
    }

    root.addView(View(this).apply {
      layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(12))
    })

    if (!execShowFinish) {
      root.addView(actionButton("Finalizar lista", COLOR_BRAND) {
        execShowFinish = true
        renderExecutionPanel()
      })
    } else {
      root.addView(buildSettlementForm(list))
    }

    return root
  }

  private fun buildEntryRow(entry: PanDb.EntryRow): View {
    val row = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(dp(4), dp(6), dp(4), dp(6))
    }
    if (!execEditing) {
      row.addView(TextView(this).apply {
        text = if (entry.done) "●" else "○"
        setTextColor(Color.parseColor(if (entry.done) COLOR_SUCCESS else COLOR_TEXT_MUTED))
        textSize = 16f
        setPadding(0, 0, dp(10), 0)
        setOnClickListener {
          try { PanDb.toggleEntryDone(this@OverlayBubbleService, entry.id, !entry.done) } catch (_: Exception) {}
          renderExecutionPanel()
        }
      })
    }
    row.addView(TextView(this).apply {
      text = entry.text
      setTextColor(Color.parseColor(if (entry.extra) COLOR_ACCENT else COLOR_TEXT))
      textSize = 14f
      layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
      if (entry.done && !execEditing) paintFlags = paintFlags or android.graphics.Paint.STRIKE_THRU_TEXT_FLAG
    })
    // Bloqueo estructural: solo los ítems 'extra' muestran la X de quitar.
    if (execEditing && entry.extra) {
      row.addView(TextView(this).apply {
        text = "✕"
        setTextColor(Color.parseColor(COLOR_ERROR))
        textSize = 14f
        setPadding(dp(10), dp(4), dp(4), dp(4))
        setOnClickListener {
          try { PanDb.deleteExtraEntry(this@OverlayBubbleService, entry.id) } catch (_: Exception) {}
          renderExecutionPanel()
        }
      })
    }
    return row
  }

  private fun buildSettlementForm(list: PanDb.ListRow): View {
    val col = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }

    // Interruptor "Es una compra": si se desactiva, se archiva la lista
    // sin registrar ningún gasto -equivalente nativo del switch homónimo
    // en CompraOverlayModal.tsx-.
    val switchRow = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      gravity = Gravity.CENTER_VERTICAL
      setPadding(0, 0, 0, dp(6))
    }
    val switchTextCol = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
      layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
    }
    switchTextCol.addView(TextView(this).apply {
      text = "Es una compra"
      setTextColor(Color.parseColor(COLOR_TEXT))
      textSize = 13.5f
      setTypeface(typeface, android.graphics.Typeface.BOLD)
    })
    switchTextCol.addView(TextView(this).apply {
      text = if (execRegisterExpense) "Se registrará como gasto" else "Se archivará sin generar gasto"
      setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
      textSize = 11f
    })
    switchRow.addView(switchTextCol)
    switchRow.addView(android.widget.Switch(this).apply {
      isChecked = execRegisterExpense
      setOnCheckedChangeListener { _, checked ->
        execRegisterExpense = checked
        renderExecutionPanel()
      }
    })
    col.addView(switchRow)

    if (execRegisterExpense) {
      col.addView(fieldLabel("Monto total gastado"))
      col.addView(EditText(this).apply {
        hint = "0.00"
        setText(execAmount)
        inputType = android.text.InputType.TYPE_CLASS_NUMBER or android.text.InputType.TYPE_NUMBER_FLAG_DECIMAL
        setBackgroundColor(Color.parseColor(COLOR_SURFACE_ALT))
        setPadding(dp(10), dp(8), dp(10), dp(8))
        addTextChangedListener(simpleWatcher { execAmount = it })
      })

      col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(8)) })
      col.addView(segmentedRow(listOf("efectivo" to "Efectivo", "transferencia" to "Transferencia", "mixto" to "Mixto"), execMethod) {
        execMethod = it
        renderExecutionPanel()
      })

      if (execMethod == "mixto") {
        col.addView(fieldLabel("Efectivo pagado"))
        col.addView(EditText(this).apply {
          hint = "0.00"
          setText(execCashAmount)
          inputType = android.text.InputType.TYPE_CLASS_NUMBER or android.text.InputType.TYPE_NUMBER_FLAG_DECIMAL
          setBackgroundColor(Color.parseColor(COLOR_SURFACE_ALT))
          setPadding(dp(10), dp(8), dp(10), dp(8))
          addTextChangedListener(simpleWatcher { execCashAmount = it })
        })
        val amt = execAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
        val cash = execCashAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
        val digital = if (amt - cash > 0) amt - cash else 0.0
        col.addView(TextView(this).apply {
          text = "Digital (calculado): S/ " + String.format(Locale.US, "%.2f", digital)
          setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
          textSize = 12f
          setPadding(0, dp(4), 0, 0)
        })
      }

      col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(10)) })
      col.addView(fieldLabel("Origen del dinero"))
      col.addView(originGrid(execOrigin) {
        execOrigin = it
        renderExecutionPanel()
      })

      col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(10)) })
      col.addView(fieldLabel("Nota (opcional)"))
      col.addView(EditText(this).apply {
        hint = "Detalle..."
        setText(execNote)
        setBackgroundColor(Color.parseColor(COLOR_SURFACE_ALT))
        setPadding(dp(10), dp(8), dp(10), dp(8))
        addTextChangedListener(simpleWatcher { execNote = it })
      })
    }

    col.addView(View(this).apply { layoutParams = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(12)) })
    val confirmLabel = when {
      execSubmitting -> "Guardando..."
      execRegisterExpense -> "Confirmar y registrar gasto"
      else -> "Finalizar sin registrar gasto"
    }
    col.addView(actionButton(confirmLabel, if (execRegisterExpense) COLOR_SUCCESS else COLOR_BRAND) {
      confirmSettlement(list)
    })

    return col
  }

  // Bloqueo estricto contra doble pulsación: mientras execSubmitting es
  // true, cualquier toque adicional sobre el botón se ignora hasta que la
  // escritura en SQLite termine (éxito o error), evitando duplicar el gasto.
  private fun confirmSettlement(list: PanDb.ListRow) {
    if (execSubmitting) return

    if (!execRegisterExpense) {
      execSubmitting = true
      renderExecutionPanel()
      val archived = try { PanDb.archiveListWithoutExpense(this, list.id) } catch (_: Exception) { false }
      execSubmitting = false
      if (archived) collapseToBubble() else renderExecutionPanel()
      return
    }

    val amount = execAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
    if (amount <= 0) return

    execSubmitting = true
    renderExecutionPanel()

    val cash = if (execMethod == "mixto") execCashAmount.replace(",", ".").toDoubleOrNull() ?: 0.0 else null
    val codeTag = if (list.listCode.isNotEmpty()) "Gasto Lista #${list.listCode}" else "Gasto de lista"
    val userNote = execNote.trim()
    val note = if (userNote.isNotEmpty()) "$userNote ($codeTag)" else codeTag

    val ok = try {
      PanDb.finalizePurchase(this, list.id, amount, execMethod, cash, execOrigin, "Lista de compras", note)
    } catch (_: Exception) {
      false
    }

    execSubmitting = false
    if (ok) {
      collapseToBubble()
    } else {
      // Falló la escritura (base no disponible, etc.): se queda en el
      // formulario para que el usuario pueda reintentar, en vez de perder
      // silenciosamente la liquidación.
      renderExecutionPanel()
    }
  }

  // -------------------------------------------------------------------
  // Helpers de UI reutilizables
  // -------------------------------------------------------------------

  private fun fieldLabel(text: String): View {
    return TextView(this).apply {
      this.text = text
      setTextColor(Color.parseColor(COLOR_TEXT_MUTED))
      textSize = 12f
      setPadding(dp(2), dp(6), 0, dp(2))
    }
  }

  private fun segmentedRow(options: List<Pair<String, String>>, value: String, onChange: (String) -> Unit): View {
    val row = LinearLayout(this).apply {
      orientation = LinearLayout.HORIZONTAL
      background = GradientDrawable().apply {
        cornerRadius = dp(10).toFloat()
        setColor(Color.parseColor(COLOR_SURFACE_ALT))
      }
      setPadding(dp(3), dp(3), dp(3), dp(3))
    }
    for ((key, label) in options) {
      val active = key == value
      row.addView(TextView(this).apply {
        text = label
        textSize = 12f
        gravity = Gravity.CENTER
        setTextColor(Color.parseColor(if (active) "#FFFFFF" else COLOR_TEXT_MUTED))
        layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
        setPadding(dp(4), dp(8), dp(4), dp(8))
        if (active) {
          background = GradientDrawable().apply {
            cornerRadius = dp(8).toFloat()
            setColor(Color.parseColor(COLOR_BRAND))
          }
        }
        setOnClickListener { onChange(key) }
      })
    }
    return row
  }

  private fun originGrid(value: String, onChange: (String) -> Unit): View {
    val options = listOf(
      "cuenta" to "Cuenta Actual",
      "vital" to "Presupuesto Vital",
      "secundario" to "Presupuesto Secundario",
      "caja_chica" to "Caja Chica",
      "ahorro" to "Ahorro"
    )
    val grid = LinearLayout(this).apply {
      orientation = LinearLayout.VERTICAL
    }
    var row: LinearLayout? = null
    options.forEachIndexed { index, (key, label) ->
      if (index % 3 == 0) {
        row = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
        grid.addView(row)
      }
      val active = key == value
      row?.addView(TextView(this).apply {
        text = label
        textSize = 10.5f
        gravity = Gravity.CENTER
        setTextColor(Color.parseColor(if (active) "#FFFFFF" else COLOR_TEXT_MUTED))
        layoutParams = LinearLayout.LayoutParams(0, dp(48), 1f).apply {
          setMargins(dp(3), dp(3), dp(3), dp(3))
        }
        background = GradientDrawable().apply {
          cornerRadius = dp(8).toFloat()
          setColor(Color.parseColor(if (active) COLOR_BRAND else COLOR_SURFACE_ALT))
        }
        setOnClickListener { onChange(key) }
      })
    }
    return grid
  }

  private fun actionButton(label: String, colorHex: String, onClick: () -> Unit): View {
    return TextView(this).apply {
      text = label
      setTextColor(Color.WHITE)
      textSize = 14f
      gravity = Gravity.CENTER
      setPadding(dp(12), dp(12), dp(12), dp(12))
      background = GradientDrawable().apply {
        cornerRadius = dp(12).toFloat()
        setColor(Color.parseColor(colorHex))
      }
      setOnClickListener { onClick() }
    }
  }

  private fun simpleWatcher(onChange: (String) -> Unit): TextWatcher {
    return object : TextWatcher {
      override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
      override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
      override fun afterTextChanged(s: Editable?) {
        onChange(s?.toString() ?: "")
      }
    }
  }

  private fun attachDragAndClick(view: View, lp: WindowManager.LayoutParams, onClick: () -> Unit) {
    var initialX = 0
    var initialY = 0
    var initialTouchX = 0f
    var initialTouchY = 0f
    var moved = false

    view.setOnTouchListener { v, event ->
      when (event.action) {
        MotionEvent.ACTION_DOWN -> {
          initialX = lp.x
          initialY = lp.y
          initialTouchX = event.rawX
          initialTouchY = event.rawY
          moved = false
          true
        }
        MotionEvent.ACTION_MOVE -> {
          val dx = (event.rawX - initialTouchX).toInt()
          val dy = (event.rawY - initialTouchY).toInt()
          if (abs(dx) > 8 || abs(dy) > 8) moved = true
          lp.x = initialX + dx
          lp.y = initialY + dy
          try {
            windowManager?.updateViewLayout(v, lp)
          } catch (_: Exception) {
          }
          true
        }
        MotionEvent.ACTION_UP -> {
          if (!moved) onClick()
          true
        }
        else -> false
      }
    }
  }
}
