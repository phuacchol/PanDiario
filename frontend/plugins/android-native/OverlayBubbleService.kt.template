  // Bloqueo estricto contra doble pulsación, igual que confirmSettlement.
  // El propio I/O de PanDb corre siempre en un hilo de fondo (ver
  // mainHandler más arriba); solo `after` -que decide si colapsar la
  // burbuja o volver a pintar el formulario con el error- se reencola en
  // el hilo principal, porque toca la vista (WindowManager).
  private fun runSubmit(work: () -> Boolean, after: (ok: Boolean) -> Unit) {
    Thread {
      val ok = try {
        work()
      } catch (_: Exception) {
        false
      }
      mainHandler.post { after(ok) }
    }.start()
  }

  private fun confirmGenericPanel(kind: String) {
    if (genSubmitting) return
    when (kind) {
      "ingreso" -> {
        val amount = genAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
        if (amount <= 0) return
        genSubmitting = true
        renderGenericPanel()
        val cash = if (genMethod == "mixto") genCashAmount.replace(",", ".").toDoubleOrNull() ?: 0.0 else null
        val category = genCategory.trim().ifEmpty { "Otros" }
        val note = genNote.trim().ifEmpty { null }
        runSubmit({ PanDb.addIncome(this, amount, genMethod, cash, category, note) }) { ok ->
          genSubmitting = false
          if (ok) collapseToBubble() else renderGenericPanel()
        }
      }
      "gasto" -> {
        val amount = genAmount.replace(",", ".").toDoubleOrNull() ?: 0.0
        if (amount <= 0) return
        genSubmitting = true
        renderGenericPanel()
        val cash = if (genMethod == "mixto") genCashAmount.replace(",", ".").toDoubleOrNull() ?: 0.0 else null
        val category = genCategory.trim().ifEmpty { "Otros" }
        val note = genNote.trim().ifEmpty { null }
        runSubmit({ PanDb.addExpense(this, amount, genMethod, cash, genOrigin, category, note) }) { ok ->
          genSubmitting = false
          if (ok) collapseToBubble() else renderGenericPanel()
        }
      }
      "nota" -> {
        val text = genText.trim()
        if (text.isEmpty()) return
        genSubmitting = true
        renderGenericPanel()
        val subject = genSubject.trim()
        runSubmit({ PanDb.addNote(this, subject, text) }) { ok ->
          genSubmitting = false
          if (ok) collapseToBubble() else renderGenericPanel()
        }
      }
      else -> {
        val title = genTitle.trim()
        if (title.isEmpty()) return
        genSubmitting = true
        renderGenericPanel()
        val items = genDraftItems.toList()
        runSubmit({ PanDb.createList(this, title, items) != null }) { ok ->
          genSubmitting = false
          if (ok) collapseToBubble() else renderGenericPanel()
        }
      }
    }
  }

