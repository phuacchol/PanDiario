<?xml version="1.0" encoding="utf-8"?>
<!--
  Tema de las "ventanas flotantes estilo diálogo" que la burbuja usa para
  Ingresos/Gastos/Notas/Lista nueva/Hablar: reutiliza las pantallas React
  Native ya existentes (ingreso.tsx, gasto.tsx, nota.tsx, lista.tsx,
  voice.tsx) dentro de un alias de MainActivity con este tema, en vez de
  reescribirlas en Kotlin.

  Extiende un tema de PLATAFORMA (prefijo android:, del propio SDK de
  Android) en vez de uno de una librería (AppCompat/Material Components):
  el build #9 falló en AAPT con "resource style/Theme.AppCompat.Light.
  Dialog.NoActionBar not found" porque ese recurso de AppCompat no queda
  expuesto en el grafo de dependencias de este proyecto al momento de
  linkear recursos. Un tema android:Theme.* viene compilado dentro del
  propio framework de Android (framework-res.apk), así que SIEMPRE está
  disponible sin importar qué librerías de UI declare o no declare el
  proyecto -no requiere agregar ninguna dependencia a build.gradle-.
-->
<resources>
  <style name="Theme.PanDiario.FloatingDialog" parent="android:Theme.DeviceDefault.Light.Dialog.NoActionBar">
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowMinWidthMajor">92%</item>
    <item name="android:windowMinWidthMinor">92%</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:backgroundDimAmount">0.45</item>
    <item name="android:windowSoftInputMode">adjustResize</item>
  </style>
</resources>
